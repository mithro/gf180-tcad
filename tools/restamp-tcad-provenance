#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Restamp a TCAD tree's provenance.json to its writer's generator_sha256, without regenerating.

    uv run --locked python tools/restamp-tcad-provenance results/tcad/moscap2d [...]
    uv run --locked python tools/restamp-tcad-provenance TREE --generator gf180tcad.tcad.__main__

Each TCAD tree root records the entry point that wrote it (``generator``) and the sha256 of that
entry point's import closure (``generator_sha256``, :func:`gf180tcad.tcad.generator_sha256`,
issue #34). This rewrites only those two fields, to what the entry point would write now: for a
tree written under the old scheme (one hash over both entry points, no ``generator``), or after a
change to the generator's code that cannot have changed the tree's data, when regenerating the
tree (hours for the 2D jobs) is not worth it. The entry point comes from the tree's path
relative to ``results/`` (``tcad/moscap2d``; :data:`gf180tcad.tcad.TREE_GENERATORS`, the
registry ``src/gf180tcad/generators.json``), never from its base name alone, so
``results/tcad-charon/moscap1d`` is not taken for ``results/tcad/moscap1d``. ``--generator``
names the writer of a tree that is not a registered tree root (one outside ``results/``, say),
and is refused if it disagrees with the writer of a registered one.

Every tree is checked before any is written. It refuses (exit 2, no file written) when, for
any tree, anything else in the file differs from what the
generator would write now: the plugin commit, an image, the calibration applied, or a
``generator`` naming another entry point. Then the tree has to be regenerated. ``--dry-run``
prints what would change and writes nothing.

A restamp is a claim that the data did not change, not evidence of it: record every restamped
tree, with the hash it had before, on docs/reproduce/index.md (tcad-provenance), then run
``make manifest``.
"""

import argparse
import json
import sys
from pathlib import Path

from gf180tcad import io, tcad
from gf180tcad.layout import PROVENANCE_NAME
from gf180tcad.sandbox import REPO_ROOT

# The fields a restamp may change.
STAMP = ("generator", "generator_sha256")

# The results root the registry's tree paths are relative to.
RESULTS_ROOT = REPO_ROOT / "results"


def restamp(tree_root: Path, generator: str, *, write: bool = True) -> tuple[str, str]:
    """Rewrite ``tree_root/provenance.json`` with the ``generator`` and its current hash.

    Returns the hash before and after (equal if the file was already current, and then it is
    not touched). Raises FileNotFoundError without a provenance.json, KeyError for an unknown
    ``generator``, and ValueError (nothing written) if anything but :data:`STAMP` would change.
    """
    path = Path(tree_root) / PROVENANCE_NAME
    committed = json.loads(path.read_bytes())
    recorded = committed.get("generator")
    if recorded is not None and recorded != generator:
        raise ValueError(
            f"{path} was written by {recorded}, not {generator}; regenerate the tree instead"
        )
    images = {k: v["name"] for k, v in committed.get("images", {}).items()}
    current = tcad.tree_provenance(tree_root, images, generator=generator)
    differs = sorted(
        k
        for k in set(committed) | set(current)
        if k not in STAMP and committed.get(k) != current.get(k)
    )
    if differs:
        raise ValueError(
            f"{path}: {', '.join(differs)} differ from what {generator} would write now, so a "
            "restamp would hide a real change; regenerate the tree instead"
        )
    old, new = committed.get("generator_sha256"), current["generator_sha256"]
    if write and committed != current:
        io.write_json(path, current)
    return old, new


def parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="tools/restamp-tcad-provenance")
    ap.add_argument(
        "trees", type=Path, nargs="+", help="TCAD tree roots, e.g. results/tcad/moscap2d"
    )
    ap.add_argument(
        "--generator",
        choices=sorted(tcad.TCAD_GENERATORS),
        help="the entry point that wrote the trees (default: from each tree's path)",
    )
    ap.add_argument("--dry-run", action="store_true", help="print the change, write nothing")
    return ap


def tree_key(tree: Path, results_root: Path | None = None) -> str | None:
    """The registry key of ``tree``: its path relative to ``results_root`` (default
    :data:`RESULTS_ROOT`) as POSIX (``tcad/moscap2d``), or None for a tree outside it."""
    results = Path(results_root if results_root is not None else RESULTS_ROOT).resolve()
    try:
        return Path(tree).resolve().relative_to(results).as_posix()
    except ValueError:
        return None


def _writer(tree: Path, override: str | None) -> str:
    """The entry point that wrote ``tree``: :data:`gf180tcad.tcad.TREE_GENERATORS` for a
    registered tree path (``override`` may only repeat it), else ``override``; ValueError
    otherwise."""
    key = tree_key(tree)
    known = tcad.TREE_GENERATORS.get(key) if key is not None else None
    if known is not None and override is not None and override != known:
        raise ValueError(
            f"{tree}: the results/{key} tree is written by {known}, not {override} (--generator)"
        )
    if known is None and override is None:
        where = f"results/{key}" if key is not None else "outside results/"
        raise ValueError(
            f"{tree} ({where}) is not one of the registered trees "
            f"{sorted(tcad.TREE_GENERATORS)}; name its writer with --generator"
        )
    return known or override


def main(argv: list[str] | None = None) -> int:
    a = parser().parse_args(argv)
    # Check every tree before writing any, so that a refusal leaves all of them unchanged.
    plan = []
    try:
        for tree in a.trees:
            generator = _writer(tree, a.generator)
            prov = Path(tree) / PROVENANCE_NAME
            stamped = json.loads(prov.read_bytes()).get("generator") == generator
            old, new = restamp(tree, generator, write=False)
            plan.append((tree, prov, generator, stamped, old, new))
    except (FileNotFoundError, ValueError) as e:
        print(f"restamp-tcad-provenance: {e}; nothing written", file=sys.stderr)
        return 2
    for tree, prov, generator, stamped, old, new in plan:
        if stamped and old == new:
            print(f"{prov.as_posix()}: current ({generator}, generator_sha256 {new})")
            continue
        if not a.dry_run:
            restamp(tree, generator)
        verb = "would restamp" if a.dry_run else "restamped"
        print(
            f"{prov.as_posix()}: generator_sha256 {old} -> {new} ({generator}); {verb}, "
            "data not regenerated"
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
