{
  "artefacts": [
    {
      "compression": "gzip",
      "description": "gmsh MSH 2.2 mesh of a 2D MOS-capacitor job (docs/limitations/moscap2d.md)",
      "ext": "msh",
      "hash_key": "mesh_sha256",
      "job_keys": [
        "device",
        "dim",
        "params"
      ],
      "meta": "cv.meta.json",
      "name": "moscap2d-mesh",
      "pattern": "tcad/**/mesh.msh"
    }
  ],
  "branch": "main",
  "format": 1,
  "max_object_bytes": 95000000,
  "primary_repo": "https://github.com/mithro/gf180-tcad",
  "repo_https": "https://github.com/mithro/gf180-tcad-output-cache",
  "repo_ssh": "git@github.com:mithro/gf180-tcad-output-cache.git"
}
